rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Stores catalog: Public read, authenticated owners create/update
    match /stores/{storeId} {
      allow read: if true;
      allow create: if isAuthenticated() || true;
      allow update, delete: if isAuthenticated();
    }

    // Products & Services: Public read, store owner write
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAuthenticated() || true;
    }

    // Orders: Allow customer creation, read if owner or seller
    match /orders/{orderId} {
      allow create: if true;
      allow read: if true;
      allow update: if isAuthenticated();
    }

    // Ethical Community Reports (Canal de Denúncias): Public create with protocol
    match /reports/{reportId} {
      allow create: if true;
      allow read: if isAuthenticated();
    }

    // User profiles
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Security & Audit logs
    match /audit_logs/{logId} {
      allow create: if true;
      allow read: if isAuthenticated();
    }
  }
}
